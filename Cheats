	local hum = char:WaitForChild("Humanoid", 10)
	if hum then captureDefaults(hum) end
	flyBV, flyBG = nil, nil
	flags.speed, flags.jump = false, false
	if S.fly then task.wait(0.3) startFly() end
	if S.spectate then setSpectate(false) S.spectate = false if setters.spectate then setters.spectate() end end
end
