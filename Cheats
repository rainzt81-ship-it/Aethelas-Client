---------------------------------------------------------------- TABS
local pages, tabButtons, pageRows = {}, {}, {}
local currentTab = nil

local function showTab(name)
	currentTab = name
	for n, p in pairs(pages) do p.Visible = (n == name) end
	for n, t in pairs(tabButtons) do
		local active = (n == name)
		tween(t.btn, 0.15, {BackgroundTransparency = active and 0.8 or 1})
		t.btn.BackgroundColor3 = ACCENT
		t.bar.BackgroundColor3 = ACCENT
		t.bar.Visible = active
		t.btn.TextColor3 = active and TEXT or MUTED
	end
end
hooks[#hooks + 1] = function() if currentTab then showTab(currentTab) end end

local function newTab(name, icon)
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = ACCENT, BackgroundTransparency = 1, AutoButtonColor = false,
		Text = "   " .. icon .. "  " .. name, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = MUTED,
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = nextOrder(),
	}, tabList)
	round(btn, 8)
	local bar = new("Frame", {Size = UDim2.new(0, 3, 0.6, 0), Position = UDim2.new(0, 0, 0.2, 0), BackgroundColor3 = ACCENT, BorderSizePixel = 0, Visible = false}, btn)
	round(bar, 2)
	tabButtons[name] = {btn = btn, bar = bar}

	local page = new("ScrollingFrame", {
		Size = UDim2.new(1, -24, 1, -58), Position = UDim2.fromOffset(12, 50), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = ACCENT, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = false,
	}, content)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}, page)
	pages[name] = page
	pageRows[page] = {}

	btn.MouseButton1Click:Connect(function() search.Text = "" showTab(name) end)
	return page
end

search:GetPropertyChangedSignal("Text"):Connect(function()
	local q = search.Text:lower()
	for _, rows in pairs(pageRows) do
		for _, r in ipairs(rows) do
			r.frame.Visible = (q == "") or (r.name ~= "" and r.name:lower():find(q, 1, true) ~= nil)
		end
	end
end)

