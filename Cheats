---------------------------------------------------------------- FEATURE: aim assist
local aimActive = false
local lockedPlayer = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local NEAREST_PARTS = {"Head", "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart", "LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm"}

local friendCache = {}
local function isFriend(p)
	local id = p.UserId
	if friendCache[id] == nil then
		friendCache[id] = false
		task.spawn(function()
			local ok, res = pcall(function() return player:IsFriendsWith(id) end)
			friendCache[id] = ok and res or false
		end)
	end
	return friendCache[id]
end

-- skips see-through and non-solid parts so thin glass or decorations don't block the check
local function isVisible(origin, targetPos, ignore)
	local dir = targetPos - origin
	for _ = 1, 5 do
		rayParams.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(origin, dir, rayParams)
		if not hit then return true end
		local part = hit.Instance
		if part.Transparency >= 0.9 or not part.CanCollide then
			table.insert(ignore, part)
		else
			return false
		end
	end
	return false
end

-- returns part, screenDistance, worldDistance, health  (or nil if not a valid target)
local function evalPlayer(p, center, camPos, myChar, fovLimit)
	local c = p.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if p == player or not hum or hum.Health <= 0 then return nil end
	if S.teamCheck and p.Team and p.Team == player.Team then return nil end
	if S.ignoreFriends and isFriend(p) then return nil end

	local names = (S.aimPart == "Head" and {"Head"}) or (S.aimPart == "Torso" and {"UpperTorso", "Torso", "HumanoidRootPart"}) or NEAREST_PARTS
	local best, bestD
	for _, n in ipairs(names) do
		local part = c:FindFirstChild(n)
		if part then
			local v, on = camera:WorldToViewportPoint(part.Position)
			if on then
				local d = (Vector2.new(v.X, v.Y) - center).Magnitude
				if not bestD or d < bestD then best, bestD = part, d end
			end
			if S.aimPart ~= "Nearest Part" then break end
		end
	end
	if not best or bestD > fovLimit then return nil end

	local dist = (best.Position - camPos).Magnitude
	if dist > S.aimMaxDist then return nil end
	if S.wallCheck and not isVisible(camPos, best.Position, {myChar, c}) then return nil end
	return best, bestD, dist, hum.Health
end

local function getTarget(center, camPos, myChar)
	if S.aimSticky and lockedPlayer then
		local part = evalPlayer(lockedPlayer, center, camPos, myChar, S.aimFov * 2)
		if part then return part end
		lockedPlayer = nil
	end
	local bestPart, bestPlayer, bestScore
	for _, p in ipairs(Players:GetPlayers()) do
		local part, sd, dist, hp = evalPlayer(p, center, camPos, myChar, S.aimFov)
		if part then
			local score = (S.aimPriority == "Crosshair" and sd) or (S.aimPriority == "Distance" and dist) or hp
			if not bestScore or score < bestScore then bestPart, bestPlayer, bestScore = part, p, score end
		end
	end
	lockedPlayer = bestPlayer
	return bestPart
end

