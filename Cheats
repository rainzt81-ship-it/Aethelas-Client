local function setToggle(key, value)
	S[key] = value
	if setters[key] then setters[key]() end
	if callbacks[key] then callbacks[key](value) end
end

local function addToggle(page, label, key, onChange)
	local row = baseRow(page, label, 38, "TextButton")
	row.Text = ""
	row.AutoButtonColor = false
	rowLabel(row, label)
	local sw = new("Frame", {Size = UDim2.fromOffset(42, 22), Position = UDim2.new(1, -54, 0.5, -11), BackgroundColor3 = Color3.fromRGB(65, 65, 82)}, row)
	round(sw, 11)
	local knob = new("Frame", {Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.new(1, 1, 1)}, sw)
	round(knob, 9)

	local function render()
		local on = S[key]
		tween(sw, 0.15, {BackgroundColor3 = on and ACCENT or Color3.fromRGB(65, 65, 82)})
		tween(knob, 0.15, {Position = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)})
	end
	render()
	setters[key] = render
	callbacks[key] = onChange
	table.insert(toggleKeys, key)
	hooks[#hooks + 1] = render

	row.MouseEnter:Connect(function() tween(row, 0.12, {BackgroundColor3 = ROW_HOVER}) end)
	row.MouseLeave:Connect(function() tween(row, 0.12, {BackgroundColor3 = ROW}) end)
	row.MouseButton1Click:Connect(function()
		setToggle(key, not S[key])
		notify(label .. (S[key] and "  ON" or "  OFF"))
	end)
end

local function fmt(v, min, max)
	if max - min <= 5 then return string.format("%.2f", v) end
	return tostring(math.floor(v + 0.5))
end

local function addSlider(page, label, key, min, max, onChange)
	local row = baseRow(page, label, 52)
	local t = rowLabel(row, label, -90)
	t.Size = UDim2.new(1, -90, 0, 30)
	local box = new("TextBox", {
		Size = UDim2.fromOffset(62, 22), Position = UDim2.new(1, -74, 0, 5), BackgroundColor3 = ROW_HOVER, Text = "",
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = ACCENT, ClearTextOnFocus = false,
	}, row)
	round(box, 6)
	local bar = new("Frame", {Size = UDim2.new(1, -24, 0, 8), Position = UDim2.new(0, 12, 0, 36), BackgroundColor3 = Color3.fromRGB(65, 65, 82)}, row)
	round(bar, 4)
	local fill = new("Frame", {BackgroundColor3 = ACCENT, Size = UDim2.new(0, 0, 1, 0)}, bar)
	round(fill, 4)
	local knob = new("Frame", {Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1)}, fill)
	round(knob, 7)

	local function render()
		fill.Size = UDim2.new((S[key] - min) / (max - min), 0, 1, 0)
		fill.BackgroundColor3 = ACCENT
		box.TextColor3 = ACCENT
		box.Text = fmt(S[key], min, max)
	end
	render()
	hooks[#hooks + 1] = render

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			S[key] = math.clamp(n, min, max)
			if onChange then onChange(S[key]) end
		end
		render()
	end)

	local dragging = false
	local function set(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		S[key] = min + (max - min) * a
		render()
		if onChange then onChange(S[key]) end
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			set(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then set(i.Position.X) end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
end

