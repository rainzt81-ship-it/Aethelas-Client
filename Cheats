}, indicator)
local indShapes = {}
local function buildIndicator()
	for _, o in ipairs(indShapes) do o:Destroy() end
	table.clear(indShapes)
	local L, col, style = S.indSize, indColor(), S.aimIndicator
	indicator.Size = UDim2.fromOffset(L, L)
	local function add(o) table.insert(indShapes, o) return o end
	if style == "Dot" then
		local d = add(new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(math.max(4, L * 0.25), math.max(4, L * 0.25)), BackgroundColor3 = col, BorderSizePixel = 0}, indicator))
		round(d, 99)
	elseif style == "Square" then
		stroke(add(new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, indicator)), col, 2)
	elseif style == "Diamond" then
		stroke(add(new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(L * 0.7, L * 0.7), BackgroundTransparency = 1, Rotation = 45}, indicator)), col, 2)
	elseif style == "Brackets" then
		local a = math.max(6, math.floor(L * 0.3))
		for _, c in ipairs({{0, 0}, {1, 0}, {0, 1}, {1, 1}}) do
			add(new("Frame", {AnchorPoint = Vector2.new(c[1], c[2]), Position = UDim2.fromScale(c[1], c[2]), Size = UDim2.fromOffset(a, 2), BackgroundColor3 = col, BorderSizePixel = 0}, indicator))
			add(new("Frame", {AnchorPoint = Vector2.new(c[1], c[2]), Position = UDim2.fromScale(c[1], c[2]), Size = UDim2.fromOffset(2, a), BackgroundColor3 = col, BorderSizePixel = 0}, indicator))
		end
	elseif style == "Arrow" then
		add(new("TextLabel", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "▼", Font = Enum.Font.GothamBold,
			TextSize = math.floor(L * 0.8), TextColor3 = col, TextStrokeTransparency = 0.4,
		}, indicator))
	end
end
buildIndicator()

local cross = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(), BackgroundTransparency = 1, Visible = false}, overlay)
local crossParts = {
	left = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), BorderSizePixel = 0}, cross),
	right = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), BorderSizePixel = 0}, cross),
	up = new("Frame", {AnchorPoint = Vector2.new(0.5, 1), BorderSizePixel = 0}, cross),
	down = new("Frame", {AnchorPoint = Vector2.new(0.5, 0), BorderSizePixel = 0}, cross),
}
local function updateCrosshair()
	local L, gap = S.crossSize, 4
	crossParts.left.Position, crossParts.left.Size = UDim2.fromOffset(-gap, 0), UDim2.fromOffset(L, 2)
	crossParts.right.Position, crossParts.right.Size = UDim2.fromOffset(gap, 0), UDim2.fromOffset(L, 2)
	crossParts.up.Position, crossParts.up.Size = UDim2.fromOffset(0, -gap), UDim2.fromOffset(2, L)
	crossParts.down.Position, crossParts.down.Size = UDim2.fromOffset(0, gap), UDim2.fromOffset(2, L)
	for _, p in pairs(crossParts) do p.BackgroundColor3 = ACCENT end
	cross.Visible = S.crosshair
end

