-- Camera work runs right AFTER Roblox's own camera script so aiming and FOV never fight it (no jitter)
RunService:BindToRenderStep("AethelasCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	-- field of view (hold-zoom wins over custom FOV)
	local wantFov = (S.holdZoom and zoomHeld and S.zoomFov) or (S.fovOn and S.fovVal) or nil
	if wantFov then camera.FieldOfView = wantFov flags.fov = true
	elseif flags.fov then camera.FieldOfView = origFov flags.fov = false end

	-- spectate follow
	if S.spectate then
		local p = Players:FindFirstChild(S.target)
		local h = p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if h and camera.CameraSubject ~= h then camera.CameraSubject = h end
	end

	-- aim assist
	local center = (S.aimOrigin == "Mouse") and UIS:GetMouseLocation() or (camera.ViewportSize / 2)
	fovCircle.Visible = S.aim and S.showFov
	fovCircle.Size = UDim2.fromOffset(S.aimFov * 2, S.aimFov * 2)
	fovCircle.Position = UDim2.fromOffset(center.X, center.Y)

	local touchOnly = UIS.TouchEnabled and not UIS.KeyboardEnabled
	local active = S.aim and (aimActive or touchOnly)
	if active and S.aimOnlyFire and not touchOnly and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then active = false end
	if not active then
		lockedPlayer = nil
		indicator.Visible = false
		return
	end
	local _, myChar = getHum()
	if not myChar then indicator.Visible = false return end

	local part = getTarget(center, camera.CFrame.Position, myChar)
	if not part then indicator.Visible = false return end

	local aimPos = part.Position + part.AssemblyLinearVelocity * S.aimPredict + Vector3.new(0, S.aimOffset, 0)
	local v = camera:WorldToViewportPoint(aimPos)
	-- deadzone: once the target is almost centered, stop nudging the camera (removes micro-jitter)
	if (Vector2.new(v.X, v.Y) - center).Magnitude > S.aimDeadzone then
		local alpha = math.clamp(1 - S.aimSmooth ^ (dt * 60), 0, 1) -- frame-rate independent smoothing
		camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, aimPos), alpha)
		v = camera:WorldToViewportPoint(aimPos)
	end

	local show = S.aimIndicator ~= "Off" or S.targetInfo
	indicator.Visible = show
	if show then
		local yOff = (S.aimIndicator == "Arrow") and -S.indSize * 0.9 or 0
		indicator.Position = UDim2.fromOffset(v.X, v.Y + yOff)
		indInfo.Visible = S.targetInfo
		if S.targetInfo and lockedPlayer then
			local h = lockedPlayer.Character and lockedPlayer.Character:FindFirstChildOfClass("Humanoid")
			indInfo.Text = string.format("%s   ❤ %d", lockedPlayer.DisplayName, h and math.floor(h.Health) or 0)
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	fps = fps + (1 / dt - fps) * 0.1
	updateDrawings()
	updateRadar()

	applyRestore("gravity", S.gravity, function() workspace.Gravity = S.gravityVal end, function() workspace.Gravity = origGravity end)
	if S.timeOn then
		if not flags.time then origLight.clock = Lighting.ClockTime end
		flags.time = true
		Lighting.ClockTime = S.timeVal
	elseif flags.time then
		Lighting.ClockTime = origLight.clock or 14
		flags.time = false
	end

	local hum, char = getHum()
	if not hum or not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")

	if hum.FloorMaterial ~= Enum.Material.Air then usedDouble = false end

	-- speed / sprint / jump
	local sprinting = S.sprint and UIS:IsKeyDown(Enum.KeyCode.LeftShift)
	applyRestore("speed", S.speed or sprinting,
		function()
			local base = S.speed and S.speedVal or defaults.speed
			hum.WalkSpeed = base * (sprinting and S.sprintMult or 1)
		end,
		function() hum.WalkSpeed = defaults.speed end)
	applyRestore("jump", S.jump,
		function() hum.UseJumpPower = true hum.JumpPower = S.jumpVal end,
		function() hum.UseJumpPower = defaults.usePower hum.JumpPower = defaults.jumpPower hum.JumpHeight = defaults.jumpHeight end)

	if S.bhop and UIS:IsKeyDown(Enum.KeyCode.Space) and hum.FloorMaterial ~= Enum.Material.Air then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
	if root then
		if S.slowFall and not S.fly then
			local v = root.AssemblyLinearVelocity
			if v.Y < -S.slowFallSpeed then root.AssemblyLinearVelocity = Vector3.new(v.X, -S.slowFallSpeed, v.Z) end
		end
		if S.spin and not S.fly then root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(S.spinSpeed), 0) end
	end

	-- fly
	if S.fly and flyBV and flyBV.Parent then
		local rel = camera.CFrame:VectorToObjectSpace(hum.MoveDirection)
		local vel = camera.CFrame.LookVector * -rel.Z + camera.CFrame.RightVector * rel.X
		if UIS:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vel -= Vector3.yAxis end
		flyBV.Velocity = vel * S.flySpeed
		flyBG.CFrame = camera.CFrame
	end
end)

RunService.Stepped:Connect(function()
	if S.noclip then
		local _, c = getHum()
		if c then
			for _, part in ipairs(c:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end
	end
end)

