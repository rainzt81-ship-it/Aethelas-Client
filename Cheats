local function updateDrawings()
	local vs = camera.ViewportSize
	local from = Vector2.new(vs.X / 2, vs.Y)
	for p, o in pairs(espObjs) do
		local c = p.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		local head = c and c:FindFirstChild("Head")
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		local ok = o.vis and root and head and hum

		if o.tracer then
			local shown = false
			if ok then
				local v, on = camera:WorldToViewportPoint(root.Position)
				if on then
					local to = Vector2.new(v.X, v.Y)
					local d = to - from
					o.tracer.Size = UDim2.fromOffset(d.Magnitude, 1.5)
					o.tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
					o.tracer.Rotation = math.deg(math.atan2(d.Y, d.X))
					shown = true
				end
			end
			o.tracer.Visible = shown
		end

		if o.box or o.hpBar then
			local shown = false
			if ok then
				local top = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
				local bot = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
				if top.Z > 0 and bot.Z > 0 then
					local h = math.abs(bot.Y - top.Y)
					local w = h * 0.55
					local cx = (top.X + bot.X) / 2
					if o.box then
						o.box.Position = UDim2.fromOffset(cx - w / 2, top.Y)
						o.box.Size = UDim2.fromOffset(w, h)
					end
					if o.hpBar then
						local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						o.hpBar.Position = UDim2.fromOffset(cx - w / 2 - 6, top.Y)
						o.hpBar.Size = UDim2.fromOffset(3, h)
						o.hpFill.Size = UDim2.fromScale(1, frac)
						o.hpFill.BackgroundColor3 = Color3.fromRGB(255, 70, 70):Lerp(Color3.fromRGB(70, 255, 120), frac)
					end
					shown = true
				end
			end
			if o.box then o.box.Visible = shown end
			if o.hpBar then o.hpBar.Visible = shown end
		end
	end
end

